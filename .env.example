# Copy this file to .env and replace placeholders locally.
# Never commit .env or real credentials.

NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/contrixai_demo
CORS_ORIGINS=http://localhost:5173
JSON_LIMIT=100kb

# M2/M4 use these for expiring server-side sessions and CSRF protection.
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
SESSION_TTL_MINUTES=60

# AI implementer / M9 configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=MODEL_NAME
EMBEDDING_MODEL=EMBEDDING_MODEL_NAME
VECTOR_INDEX_NAME=chunks_vector_index
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
STATUS_CHECK_TIMEOUT_MS=2000

# M10 seeder; synthetic demo passwords only, never print them in logs.
SEED_CONFIRM=NO
SEED_DB_NAME=contrixai_demo
SEED_CONTRIBUTOR_EMAIL=contributor@example.test
SEED_MAINTAINER_EMAIL=maintainer@example.test
SEED_MODERATOR_EMAIL=moderator@example.test
SEED_CONTRIBUTOR_PASSWORD=CHANGE_ME
SEED_MAINTAINER_PASSWORD=CHANGE_ME
SEED_MODERATOR_PASSWORD=CHANGE_ME
